<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MdPad.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MdPad"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MdPad"
    mc:Ignorable="d">
    <!-- The backdrop is set in code so the setting can change it at runtime. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The tab strip *is* the title bar, as in Windows 11 Notepad: the app icon
            sits in the strip header, the tabs and + button run along it, and the
            footer is the draggable region that keeps tabs clear of the caption buttons.
        -->
        <TabView
            x:Name="TabStrip"
            Grid.Row="0"
            VerticalAlignment="Top"
            IsAddTabButtonVisible="True"
            CanReorderTabs="True"
            CanDragTabs="False"
            TabWidthMode="Equal">
            <TabView.TabStripHeader>
                <Grid x:Name="TitleBarInset" Width="44" Height="40">
                    <!-- PNG, not the .ico: WinUI's Image decoder does not handle .ico. -->
                    <Image
                        Source="Assets/Square44x44Logo.targetsize-24_altform-unplated.png"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </TabView.TabStripHeader>
            <TabView.TabStripFooter>
                <Grid x:Name="CustomDragRegion" MinWidth="188" Height="40" />
            </TabView.TabStripFooter>
            <TabView.TabItemTemplate>
                <DataTemplate x:DataType="local:MdDocument">
                    <TabViewItem Header="{x:Bind Header, Mode=OneWay}" IsClosable="True">
                        <TabViewItem.IconSource>
                            <SymbolIconSource Symbol="Document" />
                        </TabViewItem.IconSource>
                    </TabViewItem>
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>

        <!--
            A single shared editor/preview surface lives here rather than inside each
            tab, so switching tabs swaps the document, not the whole UI tree.
        -->
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
